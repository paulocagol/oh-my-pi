-			await fs.promises.copyFile(addonPath, path.join(nativeRoot, entry));
+			await replaceNativeAddonFile(addonPath, path.join(nativeRoot, entry));
 		}
 	} finally {
 		await fs.promises.rm(tempDir, { recursive: true, force: true });
