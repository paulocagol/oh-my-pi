+	it("rejects fractional and suffixed integer flags instead of truncating them", async () => {
+		const commands: CommandEntry[] = [{ name: "bench", load: async () => BenchLikeCommand }];
+		for (const value of ["1.5", "1abc", "1e2"]) {
